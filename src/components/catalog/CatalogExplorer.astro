import zhipuLogo from '@lobehub/icons-static-svg/icons/zhipu.svg?url&no-inline';
import modelCatalog from '../../data/catalog/models.json';
import providerCatalog from '../../data/catalog/providers.json';

type CatalogKind = 'providers' | 'models';
type Locale = 'zh' | 'en';
type ProviderItem = (typeof providerCatalog.items)[number];
type ModelItem = (typeof modelCatalog.items)[number];

interface Props {
	kind: CatalogKind;
	locale: Locale;
}

const { kind, locale } = Astro.props;
const isProviders = kind === 'providers';
const catalog = isProviders ? providerCatalog : modelCatalog;
const items = catalog.items;
const sourceCommit = catalog.source.commit;
const sourceShort = sourceCommit.slice(0, 7);
const repo = `https://github.com/${catalog.source.repo}`;
const downloadUrl = `/catalog/${kind}.json`;
const editRoot = isProviders
	? `${repo}/edit/main/${providerCatalog.source_path}`
	: `${repo}/tree/main/${modelCatalog.source_path}`;
const catalogSourceUrl = `${repo}/${isProviders ? 'blob' : 'tree'}/${sourceCommit}/${catalog.source_path}`;

