	zhipu: { logo: zhipuLogo, accent: '#1f5eff' },
};

const modelItems = modelCatalog.items as ModelItem[];
const modelKindCounts = {
	all: modelItems.length,
	llm: modelItems.filter((item) => item.kind === 'llm').length,
	image: modelItems.filter((item) => item.kind === 'image').length,
};
const modelVendors = Array.from(new Map(modelItems.map((item) => [item.vendor, item.vendor_label])).entries())
	.map(([key, label]) => ({
		key,
		label,
		count: modelItems.filter((item) => item.vendor === key).length,
		accent: vendorVisuals[key]?.accent ?? '#17c8d2',
	}))
	.sort((a, b) => a.label.localeCompare(b.label));

function initials(label: string) {
	return label
		.split(/[\s()/-]+/)
		.filter(Boolean)
		.slice(0, 2)
		.map((word) => word[0])
		.join('')
		.toUpperCase();
}

function resolveVendorVisual(visual: { logo?: string; accent: string; monogram?: string }, label: string) {
	return {
		...visual,
		monogram: visual.monogram ?? initials(label),
		style: `--vendor-accent: ${visual.accent};${visual.logo ? ` --vendor-icon: url("${visual.logo.replaceAll('"', '%22')}");` : ''}`,
	};
}

function vendorVisual(key: string, label: string) {
	return resolveVendorVisual(vendorVisuals[key] ?? { accent: '#17c8d2' }, label);
}

function providerVisual(item: ProviderItem) {
	if (item.name.startsWith('Qwen AI Platform')) {
		return resolveVendorVisual({ logo: '/brand/qwen.svg', accent: '#615ced' }, item.vendor_label);
	}
	if (item.name.startsWith('Google Vertex AI')) {
		return resolveVendorVisual({ logo: vertexAiLogo, accent: '#4285f4' }, item.vendor_label);
	}
	if (item.name.startsWith('Z.AI')) {
		return resolveVendorVisual({ logo: zaiLogo, accent: '#1f5eff' }, item.vendor_label);
	}
	return vendorVisual(item.vendor_key, item.vendor_label);
}

function flattenEndpoints(item: ProviderItem) {
	const rows: Array<{ protocol: string; capability: string; url: string }> = [];
	for (const [protocol, config] of Object.entries(item.endpoints)) {
		if ('base' in config && config.base) rows.push({ protocol, capability: t.base, url: config.base });
		if ('endpoints' in config && config.endpoints) {
			for (const [capability, url] of Object.entries(config.endpoints)) {
				if (url) rows.push({ protocol, capability, url });
			}
		}
	}
	return rows;
}

function compactNumber(value: number | null | undefined) {
	if (value == null) return '—';
	if (value >= 1_000_000) return `${value / 1_000_000}M`;
	if (value >= 1_000) return `${value / 1_000}K`;
	return String(value);
}

function money(value: number, currency: 'usd' | 'cny') {
	const symbol = currency === 'usd' ? '$' : '¥';
	return `${symbol}${new Intl.NumberFormat(locale === 'zh' ? 'zh-CN' : 'en-US', {
		maximumFractionDigits: 4,
	}).format(value)}`;
}

function tierLabel(tiers: CatalogPriceTier[], index: number) {
	const current = tiers[index]?.upto;
	const previous = index > 0 ? tiers[index - 1]?.upto : null;
	if (current != null && previous != null) return `${compactNumber(previous)}–${compactNumber(current)}`;
	if (current != null) return `≤ ${compactNumber(current)}`;
	if (previous != null) return `> ${compactNumber(previous)}`;
	return t.standardTier;
}

function pricingDetails(item: ModelItem, currency: 'usd' | 'cny') {
	const profile = item.pricing[currency] as CatalogPriceProfile;
	if (profile.image_billing_mode === 'per_image' && profile.image?.default != null) {
		return {
			mode: 'per-image',
			modeLabel: t.perImageMode,
			unit: '',
			tiers: [
				{
					label: t.standardTier,
					metrics: [{ key: 'per-image', label: t.perImage, value: money(profile.image.default, currency) }],
				},
			],
		};
	}

	const tiers = profile.tiers ?? [];
	const metricDefinitions =
		item.kind === 'image'
			? [
					{ key: 'input_price', className: 'text-input', label: t.textInput },
					{ key: 'output_price', className: 'text-output', label: t.textOutput },
					{ key: 'image_input_price', className: 'image-input', label: t.imageInput },
					{ key: 'image_output_price', className: 'image-output', label: t.imageOutput },
					{ key: 'cache_read_price', className: 'cache-read', label: t.cacheRead },
					{ key: 'cache_write_price', className: 'cache-write', label: t.cacheWrite },
					{ key: 'image_input_cache_price', className: 'image-cache', label: t.imageCache },
				]
			: [
					{ key: 'input_price', className: 'text-input', label: t.input },
					{ key: 'output_price', className: 'text-output', label: t.output },
					{ key: 'cache_read_price', className: 'cache-read', label: t.cacheRead },
					{ key: 'cache_write_price', className: 'cache-write', label: t.cacheWrite },
				];

	return {
		mode: item.kind === 'image' ? 'image-token' : 'llm',
		modeLabel: t.tokenMode,
		unit: t.perMillion,
		tiers: tiers.map((tier, index) => ({
			label: tierLabel(tiers, index),
			metrics: metricDefinitions.flatMap((metric) => {
				const value = tier[metric.key as keyof CatalogPriceTier];
				return typeof value === 'number'
					? [{ key: metric.className, label: metric.label, value: money(value, currency) }]
					: [];
			}),
		})),
	};
}

const modalityNames = {
	zh: {
		text: '文本',
		image: '图片',
		file: '文件',
		audio: '音频',
		video: '视频',
	},
	en: {
		text: 'Text',
		image: 'Image',
		file: 'File',
		audio: 'Audio',
		video: 'Video',
	},
} as const;

function modalityLabel(modality: string) {
	return modalityNames[locale][modality as keyof (typeof modalityNames)[typeof locale]] ?? modality;
}

function contributionUrl(item: ProviderItem | ModelItem) {
	return `${repo}/edit/main/${item.source_path}`;
}

---

<section class="catalog-explorer" data-catalog-root data-kind={kind} data-locale={locale}>
	<nav class="catalog-switcher" aria-label={locale === 'zh' ? 'Catalog 类型' : 'Catalog type'}>
		<a class:list={{ active: isProviders }} href={`/${locale}/catalog/providers/`}>
			<span class="switcher-icon" aria-hidden="true">P</span>
			<span>
				<small>{t.eyebrow}</small>
				<strong>{t.browseProviders}</strong>
			</span>
			<em>{providerCatalog.count}</em>
		</a>
		<a class:list={{ active: !isProviders }} href={`/${locale}/catalog/models/`}>
			<span class="switcher-icon" aria-hidden="true">M</span>
			<span>
				<small>{t.eyebrow}</small>
				<strong>{t.browseModels}</strong>
			</span>
			<em>{modelCatalog.count}</em>
		</a>
	</nav>

	<div class="catalog-boundary">
		<div class="boundary-mark" aria-hidden="true">↗</div>
		<div>
			<strong>{t.customTitle}</strong>
			<p>{t.customBody}</p>
		</div>
		<a href={`/${locale}/docs/guides/${isProviders ? 'providers' : 'models'}/`}>{t.customLink} <span aria-hidden="true">→</span></a>
	</div>

	<div class:list={['catalog-browser', { 'model-browser': !isProviders }]}>
		{
			!isProviders && (
				<aside class="model-filter-sidebar" aria-label={locale === 'zh' ? '模型筛选' : 'Model filters'}>
					<section class="filter-section">
						<h2>{t.modelType}</h2>
						<div class="filter-list" role="group" aria-label={t.modelType}>
							<button type="button" class="active" data-catalog-filter="all" aria-pressed="true">
								<span>{t.all}</span>
								<em>{modelKindCounts.all}</em>
							</button>
							<button type="button" data-catalog-filter="llm" aria-pressed="false">
								<span>{t.llm}</span>
								<em>{modelKindCounts.llm}</em>
							</button>
							<button type="button" data-catalog-filter="image" aria-pressed="false">
								<span>{t.image}</span>
								<em>{modelKindCounts.image}</em>
							</button>
						</div>
					</section>
					<section class="filter-section">
						<h2>{t.vendors}</h2>
						<div class="filter-list vendor-filter-list" role="group" aria-label={t.vendors}>
							<button type="button" class="active" data-catalog-vendor="all" aria-pressed="true">
								<span>{t.allVendors}</span>
								<em>{modelCatalog.count}</em>
							</button>
							{modelVendors.map((vendor) => (
								<button
									type="button"
									data-catalog-vendor={vendor.key}
									aria-pressed="false"
									style={`--filter-accent: ${vendor.accent}`}
								>
									<span><i aria-hidden="true"></i>{vendor.label}</span>
									<em>{vendor.count}</em>
								</button>
							))}
						</div>
					</section>
				</aside>
			)
		}

		<div class="catalog-main">
			<div class:list={['catalog-toolbar', { 'model-toolbar': !isProviders }]}>
				<div class="catalog-search">
					<svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
						<circle cx="11" cy="11" r="7"></circle>
						<path d="m16.5 16.5 4 4"></path>
					</svg>
					<input
						type="search"
						autocomplete="off"
						spellcheck="false"
						placeholder={isProviders ? t.searchProviders : t.searchModels}
						aria-label={isProviders ? t.searchProviders : t.searchModels}
						data-catalog-search
					/>
					<kbd aria-hidden="true">/</kbd>
				</div>

				<div class="catalog-controls">
					{
						isProviders ? (
							<div class="catalog-chips" role="group" aria-label="Protocol">
								<button type="button" class="active" data-catalog-filter="all" aria-pressed="true"><span>{t.all}</span></button>
								<button type="button" data-catalog-filter="openai" aria-pressed="false"><span>OpenAI</span></button>
								<button type="button" data-catalog-filter="anthropic" aria-pressed="false"><span>Anthropic</span></button>
								<button type="button" data-catalog-filter="gemini" aria-pressed="false"><span>Gemini</span></button>
							</div>
						) : (
							<>
								<label class="catalog-select">
									<span class="sr-only">{locale === 'zh' ? '排序' : 'Sort'}</span>
									<select data-catalog-sort>
										<option value="released">{t.newest}</option>
										<option value="name">{t.name}</option>
										<option value="vendor">{t.vendor}</option>
									</select>
								</label>
								<div class="currency-switch" role="group" aria-label={t.currency}>
									<button type="button" class="active" data-currency-button="usd" aria-pressed="true"><span>USD</span></button>
									<button type="button" data-currency-button="cny" aria-pressed="false"><span>CNY</span></button>
								</div>
							</>
						)
					}
				</div>

				<div class="catalog-toolbar-meta">
					<p aria-live="polite"><strong data-catalog-count>{catalog.count}</strong> {t.results}</p>
					<span>{t.searchHint}</span>
				</div>
			</div>

			<div class:list={['catalog-grid', { 'provider-grid': isProviders, 'model-grid': !isProviders }]} data-catalog-grid>
		{
			isProviders
				? (items as ProviderItem[]).map((item) => {
						const endpoints = flattenEndpoints(item);
						const visual = providerVisual(item);
						const localized = item.i18n?.[locale];
						const displayName = localized?.name || item.name;
						const displayDescription = localized?.description || item.description || t.noDescription;
						const platformUrl = item.links?.api_keys || item.links?.platform;
						const platformLabel = item.links?.api_keys ? t.getApiKey : t.visitPlatform;
						const search = [
							item.name,
							item.i18n?.zh?.name ?? '',
							item.i18n?.zh?.description ?? '',
							item.i18n?.en?.name ?? '',
							item.i18n?.en?.description ?? '',
							item.vendor_label,
							item.vendor_key,
							item.description ?? '',
							...endpoints.flatMap((endpoint) => [endpoint.protocol, endpoint.capability, endpoint.url]),
						]
							.join(' ')
							.toLowerCase();
						return (
							<article
								class="catalog-card provider-card"
								data-catalog-card
								data-key={item.catalog_key}
								data-search={search}
								data-protocols={item.protocols.join(' ')}
							>
								<div class="card-head">
									<div class:list={['vendor-logo', { 'has-brand-mark': visual.logo }]} style={visual.style} aria-hidden="true">
										{visual.logo ? <span class="vendor-logo-mark"></span> : <span class="vendor-logo-fallback">{visual.monogram}</span>}
									</div>
									<div class="card-identity">
										<p>{item.vendor_label}</p>
										<h2>{displayName}</h2>
									</div>
									<div class="protocol-stack" aria-label="Protocols">
										{item.protocols.map((protocol) => (
											<span>{protocol}</span>
										))}
									</div>
								</div>
								<p class="card-description">{displayDescription}</p>
								<div class="endpoint-section">
									<div class="section-label">
										<span>{t.endpoints}</span>
										<em>{endpoints.length}</em>
									</div>
									<div class="endpoint-list">
										{endpoints.map((endpoint) => (
											<div class="endpoint-row">
												<span class={`protocol-dot protocol-${endpoint.protocol}`} aria-hidden="true"></span>
												<div>
													<small>
														{endpoint.protocol} · {endpoint.capability}
													</small>
													<code title={endpoint.url}>{endpoint.url}</code>
												</div>
												<button
													type="button"
													data-copy-value={endpoint.url}
													data-label={t.copyUrl}
													data-copied={t.copied}
													aria-label={`${t.copyUrl}: ${endpoint.url}`}
												>
													<svg aria-hidden="true" viewBox="0 0 24 24">
														<rect x="8" y="8" width="11" height="11" rx="2"></rect>
														<path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
													</svg>
												</button>
											</div>
										))}
									</div>
								</div>
								<div class="card-actions">
									<div class="card-action-links">
										{
											platformUrl && (
												<a class="provider-platform-link" href={platformUrl} target="_blank" rel="noreferrer">
													{platformLabel} <span aria-hidden="true">↗</span>
												</a>
											)
										}
										<a href={contributionUrl(item)} target="_blank" rel="noreferrer">
											{t.editSource} <span aria-hidden="true">↗</span>
										</a>
									</div>
								</div>
							</article>
						);
					})
				: (items as ModelItem[]).map((item) => {
						const visual = vendorVisual(item.vendor, item.vendor_label);
						const usdPricing = pricingDetails(item, 'usd');
						const priceProfiles = [
							{ currency: 'usd', details: usdPricing },
							{ currency: 'cny', details: pricingDetails(item, 'cny') },
						] as const;
						const displayDescription = item.i18n?.[locale] || item.description;
						const inputModalities = item.modalities?.input ?? [];
						const outputModalities = item.modalities?.output ?? [];
						const search = [
							item.id,
							item.display_name ?? '',
							item.vendor,
							item.vendor_label,
							item.description ?? '',
							item.i18n?.en ?? '',
							item.i18n?.zh ?? '',
							...(item.tags ?? []),
							...(item.modalities?.input ?? []),
							...(item.modalities?.output ?? []),
						]
							.join(' ')
							.toLowerCase();
						return (
							<article
								class:list={['catalog-card', 'model-card', item.kind]}
								data-catalog-card
								data-key={item.id}
								data-search={search}
								data-model-kind={item.kind}
								data-vendor={item.vendor}
								data-name={(item.display_name ?? item.id).toLowerCase()}
								data-released={item.released ?? ''}
							>
								<div class="model-card-header">
									<div class="model-card-heading">
										<div class:list={['vendor-logo', { 'has-brand-mark': visual.logo }]} style={visual.style} aria-hidden="true">
											{visual.logo ? <span class="vendor-logo-mark"></span> : <span class="vendor-logo-fallback">{visual.monogram}</span>}
										</div>
										<div class="card-identity">
											<div class="model-vendor-row">
												<p>{item.vendor_label}</p>
												<span class:list={['model-kind', item.kind]}>{item.kind === 'image' ? t.image : t.llm}</span>
												{(item.tags ?? []).map((tag) => <span class="signal-tag">{tag}</span>)}
											</div>
											<div class="model-title-row">
												<h2>{item.display_name ?? item.id}</h2>
												<div class="model-id-row">
													<code>{item.id}</code>
													<button
														type="button"
														data-copy-value={item.id}
														data-label={t.copyModelId}
														data-copied={t.copied}
														aria-label={`${t.copyModelId}: ${item.id}`}
													>
														<svg aria-hidden="true" viewBox="0 0 24 24">
															<rect x="8" y="8" width="11" height="11" rx="2"></rect>
															<path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
														</svg>
													</button>
												</div>
											</div>
										</div>
									</div>
									<div class="model-header-meta">
										<dl class="model-quick-facts">
											{
												item.kind === 'llm' ? (
													<>
														<div>
															<dt class="model-fact-label">{t.context}</dt>
															<dd class="model-fact-value">{compactNumber(item.context_window)}</dd>
														</div>
														<div>
															<dt class="model-fact-label">{t.maxOutput}</dt>
															<dd class="model-fact-value">{compactNumber(item.max_tokens)}</dd>
														</div>
													</>
												) : (
													<div>
														<dt class="model-fact-label">{t.billing}</dt>
														<dd class="model-fact-value">{usdPricing.modeLabel}</dd>
													</div>
												)
											}
											<div>
												<dt class="model-fact-label">{t.released}</dt>
												<dd class="model-fact-value">{item.released ?? '—'}</dd>
											</div>
										</dl>
										<div class="model-edit-action">
											<span>{t.dataAction}</span>
											<a class="model-edit-link" href={contributionUrl(item)} target="_blank" rel="noreferrer">
												{t.editSource} <span aria-hidden="true">↗</span>
											</a>
										</div>
									</div>
								</div>
								<div class="model-card-content">
									<div class="model-overview">
										<p class="model-description" title={displayDescription}>{displayDescription}</p>
										<section class="modality-panel" aria-label={t.modalities}>
											<span class="modality-label">{t.modalities}</span>
											<div class="modality-flow">
												<div class="modality-group" aria-label={t.input}>
													<div class="modality-icons">
														{
															inputModalities.map((modality) => (
																<span class:list={['modality-icon', modality]} title={modalityLabel(modality)}>
																	{
																		modality === 'text' ? (
																			<b aria-hidden="true">T</b>
																		) : modality === 'image' ? (
																			<svg aria-hidden="true" viewBox="0 0 24 24">
																				<rect x="3.5" y="4" width="17" height="16" rx="2"></rect>
																				<circle cx="9" cy="9" r="1.5"></circle>
																				<path d="m5.5 17 4.2-4 3.1 2.7 2.3-2.2 3.4 3.5"></path>
																			</svg>
																		) : modality === 'file' ? (
																			<svg aria-hidden="true" viewBox="0 0 24 24">
																				<path d="M6 3.5h7l5 5V21H6z"></path>
																				<path d="M13 3.5v5h5"></path>
																			</svg>
																		) : modality === 'audio' ? (
																			<svg aria-hidden="true" viewBox="0 0 24 24">
																				<path d="M5 10v4M9 7v10M13 4v16M17 8v8M21 10v4"></path>
																			</svg>
																		) : modality === 'video' ? (
																			<svg aria-hidden="true" viewBox="0 0 24 24">
																				<rect x="3.5" y="5" width="17" height="14" rx="2"></rect>
																				<path d="m10 9 5 3-5 3z"></path>
																			</svg>
																		) : (
																			<b aria-hidden="true">{modality.slice(0, 2).toUpperCase()}</b>
																		)
																	}
																	<span class="sr-only">{modalityLabel(modality)}</span>
																</span>
															))
														}
													</div>
												</div>
												<svg class="modality-arrow" aria-hidden="true" viewBox="0 0 24 24">
													<path d="M5 12h14M14 7l5 5-5 5"></path>
												</svg>
												<div class="modality-group" aria-label={t.output}>
													<div class="modality-icons">
														{
															outputModalities.map((modality) => (
																<span class:list={['modality-icon', modality]} title={modalityLabel(modality)}>
																	{
																		modality === 'text' ? (
																			<b aria-hidden="true">T</b>
																		) : modality === 'image' ? (
																			<svg aria-hidden="true" viewBox="0 0 24 24">
																				<rect x="3.5" y="4" width="17" height="16" rx="2"></rect>
																				<circle cx="9" cy="9" r="1.5"></circle>
																				<path d="m5.5 17 4.2-4 3.1 2.7 2.3-2.2 3.4 3.5"></path>
																			</svg>
																		) : modality === 'file' ? (
																			<svg aria-hidden="true" viewBox="0 0 24 24">
																				<path d="M6 3.5h7l5 5V21H6z"></path>
																				<path d="M13 3.5v5h5"></path>
																			</svg>
																		) : modality === 'audio' ? (
																			<svg aria-hidden="true" viewBox="0 0 24 24">
																				<path d="M5 10v4M9 7v10M13 4v16M17 8v8M21 10v4"></path>
																			</svg>
																		) : modality === 'video' ? (
																			<svg aria-hidden="true" viewBox="0 0 24 24">
																				<rect x="3.5" y="5" width="17" height="14" rx="2"></rect>
																				<path d="m10 9 5 3-5 3z"></path>
																			</svg>
																		) : (
																			<b aria-hidden="true">{modality.slice(0, 2).toUpperCase()}</b>
																		)
																	}
																	<span class="sr-only">{modalityLabel(modality)}</span>
																</span>
															))
														}
													</div>
												</div>
											</div>
										</section>
									</div>
									<aside class:list={['model-pricing-panel', usdPricing.mode]} aria-label={t.pricing}>
										<header>
											<div>
												<span>{t.pricing}</span>
												<strong>{usdPricing.modeLabel}</strong>
											</div>
											<small>{usdPricing.unit}</small>
										</header>
										{
											priceProfiles.map(({ currency, details }) => (
												<div class="price-profile" data-currency-price={currency} hidden={currency === 'cny'}>
													{details.tiers.map((tier) => (
														<div class="price-tier">
															<span class="price-tier-label">{tier.label}</span>
															<div class="price-metrics">
																{tier.metrics.map((metric) => (
																	<div class:list={['price-metric', metric.key]}>
																		<small>{metric.label}</small>
																		<strong>{metric.value}</strong>
																	</div>
																))}
															</div>
														</div>
													))}
												</div>
											))
										}
									</aside>
								</div>
							</article>
						);
					})
		}
			</div>

			<div class="catalog-empty" data-catalog-empty hidden>
				<div aria-hidden="true">⌕</div>
				<h2>{t.noResults}</h2>
				<p>{t.noResultsBody}</p>
				<button type="button" data-catalog-clear>{t.clear}</button>
			</div>

			{!isProviders && <p class="catalog-price-note">{t.priceNote}</p>}
		</div>
	</div>

	<section class="catalog-contribute">
		<div class="contribute-copy">
			<p class="contribute-kicker">{t.dataTools}</p>
			<h2>{isProviders ? t.contributeProvider : t.contributeModel}</h2>
			<p>{isProviders ? t.contributeProviderBody : t.contributeModelBody}</p>
		</div>
		<a class="contribute-primary" href={editRoot} target="_blank" rel="noreferrer">
			{t.openContribution} <span aria-hidden="true">↗</span>
		</a>
	</section>
</section>

<script>
	function initializeCatalogApiCopy() {
		document.querySelectorAll<HTMLButtonElement>('[data-catalog-api-copy]').forEach((button) => {
			if (button.dataset.ready === 'true') return;
			button.dataset.ready = 'true';
			button.addEventListener('click', async () => {
				const value = button.dataset.copyValue ?? '';
				try {
					await navigator.clipboard.writeText(value);
				} catch {
					const textarea = document.createElement('textarea');
					textarea.value = value;
					textarea.style.position = 'fixed';
					textarea.style.opacity = '0';
					document.body.append(textarea);
					textarea.select();
					document.execCommand('copy');
					textarea.remove();
				}
				const state = button.querySelector<HTMLElement>('[data-copy-state]');
				const original = button.dataset.copyLabel ?? 'Copy';
				if (state) state.textContent = button.dataset.copiedLabel ?? 'Copied';
				button.classList.add('copied');
				window.setTimeout(() => {
					if (state) state.textContent = original;
					button.classList.remove('copied');
				}, 1400);
			});
		});
	}

	function initializeCatalogs() {
		document.querySelectorAll<HTMLElement>('[data-catalog-root]').forEach((root) => {
			if (root.dataset.ready === 'true') return;
			root.dataset.ready = 'true';

			const kind = root.dataset.kind;
			const search = root.querySelector<HTMLInputElement>('[data-catalog-search]');
			const count = root.querySelector<HTMLElement>('[data-catalog-count]');
			const grid = root.querySelector<HTMLElement>('[data-catalog-grid]');
			const empty = root.querySelector<HTMLElement>('[data-catalog-empty]');
			const sort = root.querySelector<HTMLSelectElement>('[data-catalog-sort]');
			const filterButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-catalog-filter]'));
			const vendorButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-catalog-vendor]'));
			const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-catalog-card]'));
			let activeFilter = 'all';
			let activeVendor = 'all';

			const normalize = (value: string) =>
				value
					.toLocaleLowerCase()
					.normalize('NFKD')
					.replace(/\p{Diacritic}/gu, '');

			const update = () => {
				const query = normalize(search?.value.trim() ?? '');
				let visible = 0;
				for (const card of cards) {
					const matchesSearch = !query || normalize(card.dataset.search ?? '').includes(query);
					const matchesFilter =
						activeFilter === 'all' ||
						(kind === 'providers'
							? (card.dataset.protocols ?? '').split(' ').includes(activeFilter)
							: card.dataset.modelKind === activeFilter);
					const matchesVendor = activeVendor === 'all' || card.dataset.vendor === activeVendor;
					const show = matchesSearch && matchesFilter && matchesVendor;
					card.hidden = !show;
					if (show) visible += 1;
				}
				if (count) count.textContent = String(visible);
				if (empty) empty.hidden = visible !== 0;

				const url = new URL(window.location.href);
				query ? url.searchParams.set('q', search?.value.trim() ?? '') : url.searchParams.delete('q');
				activeFilter !== 'all'
					? url.searchParams.set(kind === 'providers' ? 'protocol' : 'type', activeFilter)
					: url.searchParams.delete(kind === 'providers' ? 'protocol' : 'type');
				activeVendor !== 'all' ? url.searchParams.set('vendor', activeVendor) : url.searchParams.delete('vendor');
				history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`);
			};

			const applySort = () => {
				if (!grid || kind !== 'models') return;
				const mode = sort?.value ?? 'released';
				const sorted = [...cards].sort((a, b) => {
					if (mode === 'name') return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '');
					if (mode === 'vendor') {
						return (a.dataset.vendor ?? '').localeCompare(b.dataset.vendor ?? '') ||
							(a.dataset.name ?? '').localeCompare(b.dataset.name ?? '');
					}
					return (b.dataset.released ?? '').localeCompare(a.dataset.released ?? '') ||
						(a.dataset.name ?? '').localeCompare(b.dataset.name ?? '');
				});
				sorted.forEach((card) => grid.append(card));
			};

			const params = new URLSearchParams(window.location.search);
			if (search && params.has('q')) search.value = params.get('q') ?? '';
			const requestedFilter = params.get(kind === 'providers' ? 'protocol' : 'type');
			if (requestedFilter && filterButtons.some((button) => button.dataset.catalogFilter === requestedFilter)) {
				activeFilter = requestedFilter;
			}
			const requestedVendor = params.get('vendor');
			if (requestedVendor && vendorButtons.some((button) => button.dataset.catalogVendor === requestedVendor)) {
				activeVendor = requestedVendor;
			}
			filterButtons.forEach((button) => {
				button.classList.toggle('active', button.dataset.catalogFilter === activeFilter);
				button.setAttribute('aria-pressed', String(button.dataset.catalogFilter === activeFilter));
				button.addEventListener('click', () => {
					activeFilter = button.dataset.catalogFilter ?? 'all';
					filterButtons.forEach((candidate) => {
						candidate.classList.toggle('active', candidate === button);
						candidate.setAttribute('aria-pressed', String(candidate === button));
					});
					update();
				});
			});
			vendorButtons.forEach((button) => {
				button.classList.toggle('active', button.dataset.catalogVendor === activeVendor);
				button.setAttribute('aria-pressed', String(button.dataset.catalogVendor === activeVendor));
				button.addEventListener('click', () => {
					activeVendor = button.dataset.catalogVendor ?? 'all';
					vendorButtons.forEach((candidate) => {
						candidate.classList.toggle('active', candidate === button);
						candidate.setAttribute('aria-pressed', String(candidate === button));
					});
					update();
				});
			});

			search?.addEventListener('input', update);
			sort?.addEventListener('change', applySort);
			root.querySelector('[data-catalog-clear]')?.addEventListener('click', () => {
				if (search) search.value = '';
				activeFilter = 'all';
				activeVendor = 'all';
				filterButtons.forEach((button) => {
					const active = button.dataset.catalogFilter === 'all';
					button.classList.toggle('active', active);
					button.setAttribute('aria-pressed', String(active));
				});
				vendorButtons.forEach((button) => {
					const active = button.dataset.catalogVendor === 'all';
					button.classList.toggle('active', active);
					button.setAttribute('aria-pressed', String(active));
				});
				update();
				search?.focus();
			});

			root.querySelectorAll<HTMLButtonElement>('[data-currency-button]').forEach((button) => {
				button.addEventListener('click', () => {
					const currency = button.dataset.currencyButton;
					root.querySelectorAll<HTMLButtonElement>('[data-currency-button]').forEach((candidate) => {
						candidate.classList.toggle('active', candidate === button);
						candidate.setAttribute('aria-pressed', String(candidate === button));
					});
					root.querySelectorAll<HTMLElement>('[data-currency-price]').forEach((price) => {
						price.hidden = price.dataset.currencyPrice !== currency;
					});
				});
			});

			const writeClipboard = async (value: string, button: HTMLButtonElement) => {
				try {
					await navigator.clipboard.writeText(value);
				} catch {
					const textarea = document.createElement('textarea');
					textarea.value = value;
					textarea.style.position = 'fixed';
					textarea.style.opacity = '0';
					document.body.append(textarea);
					textarea.select();
					document.execCommand('copy');
					textarea.remove();
				}
				const oldLabel = button.getAttribute('aria-label');
				button.classList.add('copied');
				button.setAttribute('aria-label', button.dataset.copied ?? 'Copied');
				window.setTimeout(() => {
					button.classList.remove('copied');
					if (oldLabel) button.setAttribute('aria-label', oldLabel);
				}, 1400);
			};

			root.querySelectorAll<HTMLButtonElement>('[data-copy-value]').forEach((button) => {
				button.addEventListener('click', () => writeClipboard(button.dataset.copyValue ?? '', button));
			});
			const keyHandler = (event: KeyboardEvent) => {
				const target = event.target as HTMLElement | null;
				const isEditing = target?.matches('input, textarea, select, [contenteditable="true"]');
				if (event.key === '/' && !isEditing) {
					event.preventDefault();
					search?.focus();
				}
				if (event.key === 'Escape' && document.activeElement === search && search?.value) {
					search.value = '';
					update();
				}
			};
			document.addEventListener('keydown', keyHandler);
			document.addEventListener('astro:before-swap', () => document.removeEventListener('keydown', keyHandler), {
				once: true,
			});

			applySort();
			update();
		});
	}

	initializeCatalogApiCopy();
	initializeCatalogs();
	document.addEventListener('astro:page-load', initializeCatalogApiCopy);
	document.addEventListener('astro:page-load', initializeCatalogs);
</script>

<style>
	.catalog-explorer {
		--catalog-cyan: var(--of-accent);
		--catalog-green: var(--of-accent-hover);
		--catalog-panel: color-mix(in srgb, var(--of-surface-card-solid) 96%, transparent);
		--catalog-soft: color-mix(in srgb, var(--of-accent) 8%, var(--of-surface-card));
		width: 100%;
		max-width: 84rem;
		margin-inline: auto;
		padding-bottom: 3rem;
	}

	.catalog-explorer h2 {
		margin-top: 0;
		padding-bottom: 0;
		border-bottom: 0;
	}

	.catalog-explorer h2::before {
		display: none;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.catalog-switcher {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
		margin-bottom: 1rem;
	}

	.catalog-switcher a {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: 0.85rem;
		align-items: center;
		min-width: 0;
		padding: 0.85rem 1rem;
		border: 1px solid var(--of-border-default);
		border-radius: 0.85rem;
		color: var(--of-text-secondary);
		text-decoration: none;
		background: var(--catalog-panel);
		box-shadow: var(--sl-shadow-sm);
		transition: border-color 160ms ease, transform 160ms ease, background 160ms ease;
	}

	.catalog-switcher a:hover {
		border-color: var(--of-border-strong);
		transform: translateY(-1px);
	}

	.catalog-switcher a.active {
		border-color: color-mix(in srgb, var(--catalog-cyan) 58%, transparent);
		color: var(--of-text-primary);
		background:
			linear-gradient(115deg, color-mix(in srgb, var(--catalog-cyan) 13%, transparent), transparent 50%),
			var(--catalog-panel);
	}

	.switcher-icon {
		display: grid;
		place-items: center;
		width: 2.35rem;
		height: 2.35rem;
		border: 1px solid var(--of-card-icon-border);
		border-radius: 0.65rem;
		font: 600 0.85rem/1 var(--sl-font-mono);
		color: var(--catalog-cyan);
		background: var(--of-card-icon-bg);
	}

	.catalog-switcher small,
	.catalog-switcher strong {
		display: block;
	}

	.catalog-switcher small {
		margin-bottom: 0.1rem;
		font: 500 0.61rem/1.2 var(--sl-font-mono);
		letter-spacing: 0.11em;
		color: var(--of-text-muted);
	}

	.catalog-switcher strong {
		font-size: 0.96rem;
	}

	.catalog-switcher em {
		display: grid;
		place-items: center;
		min-width: 2.1rem;
		height: 1.65rem;
		padding-inline: 0.4rem;
		border-radius: 999px;
		font: 500 0.72rem/1 var(--sl-font-mono);
		font-style: normal;
		color: var(--of-text-muted);
		background: color-mix(in srgb, var(--of-text-primary) 7%, transparent);
	}

	.catalog-boundary {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		gap: 1rem;
		align-items: center;
		padding: 0.78rem 1rem;
		margin-bottom: 1rem;
		border: 1px solid color-mix(in srgb, var(--of-signal-warn) 38%, var(--of-border-default));
		border-radius: 0.85rem;
		background:
			linear-gradient(110deg, color-mix(in srgb, var(--of-signal-warn) 9%, transparent), transparent 60%),
			var(--catalog-panel);
	}

	.boundary-mark {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 0.6rem;
		color: var(--of-signal-warn);
		background: color-mix(in srgb, var(--of-signal-warn) 13%, transparent);
		font-weight: 700;
	}

	.catalog-boundary strong {
		display: block;
		margin-bottom: 0.18rem;
		color: var(--of-text-primary);
	}

	.catalog-boundary p {
		max-width: 62rem;
		margin: 0;
		color: var(--of-text-muted);
		font-size: 0.82rem;
		line-height: 1.48;
	}

	.catalog-boundary a {
		white-space: nowrap;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--of-signal-warn);
		text-decoration: none;
	}

	.catalog-browser,
	.catalog-main {
		min-width: 0;
	}

	.catalog-main {
		margin-top: 0;
	}

	.model-browser {
		display: grid;
		grid-template-columns: 14rem minmax(0, 1fr);
		gap: 1rem;
		align-items: start;
	}

	.model-filter-sidebar {
		position: sticky;
		top: calc(var(--sl-nav-height) + 0.5rem);
		min-width: 0;
		max-height: calc(100vh - var(--sl-nav-height) - 1rem);
		padding: 0.75rem;
		overflow: auto;
		border: 1px solid var(--of-border-default);
		border-radius: 0.95rem;
		background:
			linear-gradient(145deg, color-mix(in srgb, var(--catalog-cyan) 5%, transparent), transparent 46%),
			color-mix(in srgb, var(--of-surface-card-solid) 96%, transparent);
		box-shadow: var(--sl-shadow-sm);
		scrollbar-width: thin;
		scrollbar-color: color-mix(in srgb, var(--of-text-muted) 35%, transparent) transparent;
	}

	.filter-section + .filter-section {
		padding-top: 0.85rem;
		margin-top: 0.85rem;
		border-top: 1px solid var(--of-border-subtle);
	}

	.filter-section,
	.filter-list {
		min-width: 0;
	}

	.filter-section h2 {
		margin: 0 0 0.55rem;
		color: var(--of-text-muted);
		font: 600 0.65rem/1.2 var(--sl-font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.filter-list {
		display: grid;
		gap: 0.18rem;
	}

	.filter-list button {
		--filter-accent: var(--catalog-cyan);

		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.55rem;
		width: 100%;
		min-height: 2.2rem;
		padding: 0.42rem 0.48rem 0.42rem 0.58rem;
		border: 1px solid transparent;
		border-radius: 0.5rem;
		color: var(--of-text-secondary);
		background: transparent;
		font: 500 0.73rem/1.2 var(--sl-font);
		text-align: left;
		cursor: pointer;
		transition: color 140ms ease, border-color 140ms ease, background 140ms ease;
	}

	.filter-list button:hover {
		border-color: var(--of-border-subtle);
		color: var(--of-text-primary);
		background: color-mix(in srgb, var(--of-text-primary) 4%, transparent);
	}

	.filter-list button.active {
		border-color: color-mix(in srgb, var(--catalog-cyan) 35%, var(--of-border-default));
		color: var(--of-text-primary);
		background:
			linear-gradient(90deg, color-mix(in srgb, var(--catalog-cyan) 13%, transparent), transparent 90%),
			color-mix(in srgb, var(--of-bg-base) 56%, transparent);
	}

	.filter-list button > span {
		display: flex;
		align-items: center;
		gap: 0.48rem;
		min-width: 0;
	}

	.vendor-filter-list button > span {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.vendor-filter-list i {
		flex: 0 0 auto;
		width: 0.42rem;
		height: 0.42rem;
		border-radius: 50%;
		background: var(--filter-accent);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--filter-accent) 12%, transparent);
	}

	.filter-list em {
		display: grid;
		flex: 0 0 auto;
		place-items: center;
		min-width: 1.65rem;
		height: 1.35rem;
		padding-inline: 0.35rem;
		border-radius: 999px;
		color: var(--of-text-muted);
		background: color-mix(in srgb, var(--of-text-primary) 6%, transparent);
		font: 500 0.62rem/1 var(--sl-font-mono);
		font-style: normal;
	}

	.filter-list button.active em {
		color: var(--catalog-cyan);
		background: color-mix(in srgb, var(--catalog-cyan) 12%, transparent);
	}

	.catalog-toolbar {
		position: sticky;
		top: calc(var(--sl-nav-height) + 0.5rem);
		z-index: 8;
		padding: 0.7rem;
		margin-bottom: 1rem;
		border: 1px solid var(--of-border-default);
		border-radius: 0.95rem;
		background: color-mix(in srgb, var(--of-surface-card-solid) 95%, transparent);
		box-shadow: 0 14px 34px color-mix(in srgb, var(--of-bg-base) 58%, transparent);
		backdrop-filter: blur(18px) saturate(1.15);
	}

	.catalog-search {
		position: relative;
		display: flex;
		align-items: center;
	}

	.catalog-search svg {
		position: absolute;
		left: 0.9rem;
		fill: none;
		stroke: var(--of-text-muted);
		stroke-width: 1.8;
		pointer-events: none;
	}

	.catalog-search input {
		width: 100%;
		height: 2.7rem;
		padding: 0 3rem;
		border: 1px solid var(--of-border-default);
		border-radius: 0.72rem;
		outline: none;
		color: var(--of-text-primary);
		background: color-mix(in srgb, var(--of-bg-base) 76%, transparent);
		font: 500 0.94rem/1 var(--sl-font);
		transition: border-color 150ms ease, box-shadow 150ms ease;
	}

	.catalog-search input:focus {
		border-color: var(--catalog-cyan);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--catalog-cyan) 14%, transparent);
	}

	.catalog-search kbd {
		position: absolute;
		right: 0.8rem;
		display: grid;
		place-items: center;
		width: 1.65rem;
		height: 1.65rem;
		border: 1px solid var(--of-border-default);
		border-bottom-width: 2px;
		border-radius: 0.38rem;
		font: 500 0.73rem/1 var(--sl-font-mono);
		color: var(--of-text-muted);
		background: var(--of-surface-card);
	}

	.catalog-controls {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		align-items: center;
		margin-top: 0.7rem;
	}

	.catalog-controls > * {
		margin-block: 0;
	}

	.catalog-chips,
	.currency-switch {
		display: flex;
		box-sizing: border-box;
		align-items: center;
		gap: 0.25rem;
		height: 2.7rem;
		padding: 0.22rem;
		border: 1px solid var(--of-border-default);
		border-radius: 0.58rem;
		background: color-mix(in srgb, var(--of-bg-base) 64%, transparent);
	}

	.catalog-chips button,
	.currency-switch button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 2.1rem;
		min-height: 0;
		margin: 0;
		padding: 0.38rem 0.7rem;
		border: 0;
		border-radius: 0.42rem;
		color: var(--of-text-muted);
		background: transparent;
		font: 600 0.72rem/1 var(--sl-font);
		cursor: pointer;
	}

	.catalog-chips button:hover,
	.currency-switch button:hover {
		color: var(--of-text-primary);
	}

	.catalog-chips button > span,
	.currency-switch button > span {
		display: block;
		transform: translateY(-2px);
	}

	.catalog-chips button.active,
	.currency-switch button.active {
		color: var(--of-text-invert);
		background: var(--catalog-cyan);
		box-shadow: 0 3px 10px color-mix(in srgb, var(--catalog-cyan) 22%, transparent);
	}

	.catalog-select {
		display: block;
	}

	.catalog-select select {
		height: 2.7rem;
		max-width: 13rem;
		padding: 0 2rem 0 0.72rem;
		border: 1px solid var(--of-border-default);
		border-radius: 0.58rem;
		outline: none;
		color: var(--of-text-secondary);
		background-color: color-mix(in srgb, var(--of-bg-base) 64%, transparent);
		font: 500 0.76rem/1 var(--sl-font);
	}

	.catalog-select select:focus {
		border-color: var(--catalog-cyan);
	}

	.catalog-toolbar-meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: 0.65rem;
		color: var(--of-text-muted);
		font-size: 0.72rem;
	}

	.catalog-toolbar-meta p {
		margin: 0;
	}

	.catalog-toolbar-meta strong {
		color: var(--of-text-primary);
		font: 600 0.82rem/1 var(--sl-font-mono);
	}

	@media (min-width: 70rem) {
		.catalog-toolbar {
			display: grid;
			grid-template-columns: minmax(22rem, 1fr) max-content;
			gap: 0.55rem 0.75rem;
			align-items: center;
		}

		.catalog-controls {
			flex-wrap: nowrap;
			margin-top: 0;
		}

		.catalog-toolbar-meta {
			grid-column: 1 / -1;
			margin-top: 0.05rem;
			padding-inline: 0.15rem;
		}

		.model-toolbar .catalog-controls {
			justify-content: flex-end;
		}
	}

	.catalog-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.85rem;
		align-items: stretch;
	}

	.model-grid {
		grid-template-columns: minmax(0, 1fr);
		gap: 0.65rem;
	}

	.catalog-card {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		min-width: 0;
		margin: 0;
		overflow: hidden;
		border: 1px solid var(--of-card-border);
		border-radius: 0.95rem;
		background:
			linear-gradient(145deg, color-mix(in srgb, var(--catalog-cyan) 4%, transparent), transparent 42%),
			var(--catalog-panel);
		box-shadow: var(--sl-shadow-sm);
		transition: border-color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
	}

	.catalog-card::before {
		position: absolute;
		inset: 0 auto auto 0;
		width: 4rem;
		height: 1px;
		content: '';
		background: linear-gradient(90deg, var(--catalog-cyan), transparent);
	}

	.catalog-card:hover {
		border-color: var(--of-card-border-hover);
		transform: translateY(-2px);
		box-shadow: var(--sl-shadow-md);
	}

	.card-head {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		gap: 0.75rem;
		align-items: center;
		padding: 1rem 1rem 0;
	}

	.vendor-logo {
		--vendor-accent: var(--catalog-cyan);

		position: relative;
		display: grid;
		place-items: center;
		width: 2.7rem;
		height: 2.7rem;
		overflow: hidden;
		isolation: isolate;
		border: 1px solid color-mix(in srgb, var(--vendor-accent) 34%, var(--of-border-default));
		border-radius: 0.72rem;
		color: color-mix(in srgb, var(--vendor-accent) 62%, var(--of-text-primary));
		background:
			linear-gradient(145deg, color-mix(in srgb, var(--vendor-accent) 16%, transparent), transparent 58%),
			color-mix(in srgb, var(--of-surface-card-solid) 94%, var(--vendor-accent));
		font: 700 0.72rem/1 var(--sl-font-mono);
		box-shadow:
			inset 0 1px 0 color-mix(in srgb, var(--of-text-primary) 10%, transparent),
			0 0 0 1px color-mix(in srgb, var(--vendor-accent) 5%, transparent);
	}

	.vendor-logo::after {
		position: absolute;
		inset: 0;
		z-index: -1;
		content: '';
		background: radial-gradient(circle at 76% 18%, color-mix(in srgb, var(--vendor-accent) 20%, transparent), transparent 42%);
	}

	.vendor-logo-mark {
		width: 1.62rem;
		height: 1.62rem;
		background: currentColor;
		-webkit-mask: var(--vendor-icon) center / contain no-repeat;
		mask: var(--vendor-icon) center / contain no-repeat;
	}

	.vendor-logo-fallback {
		display: grid;
		place-items: center;
		min-width: 1.7rem;
		height: 1.7rem;
		padding-inline: 0.12rem;
		border-radius: 0.48rem;
		letter-spacing: -0.045em;
		background: color-mix(in srgb, var(--vendor-accent) 10%, transparent);
	}

	.vendor-logo-fallback:not(:only-child) {
		display: none;
	}

	.card-identity {
		min-width: 0;
		transform: translateY(-4px);
	}

	.card-identity p {
		margin: 0 0 0.18rem;
		overflow: hidden;
		color: var(--of-text-muted);
		font-size: 0.74rem;
		line-height: 1.2;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.card-identity h2 {
		margin: 0;
		overflow: hidden;
		color: var(--of-text-primary);
		font-size: 1rem;
		line-height: 1.25;
		letter-spacing: -0.015em;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.protocol-stack {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.28rem;
	}

	.protocol-stack span,
	.model-kind {
		padding: 0.28rem 0.46rem;
		border: 1px solid var(--of-border-default);
		border-radius: 999px;
		color: var(--of-text-muted);
		background: color-mix(in srgb, var(--of-bg-base) 64%, transparent);
		font: 500 0.62rem/1 var(--sl-font-mono);
		text-transform: uppercase;
	}

	.model-kind.image {
		border-color: color-mix(in srgb, var(--of-accent-alt) 52%, transparent);
		color: var(--of-accent-alt);
		background: color-mix(in srgb, var(--of-accent-alt) 9%, transparent);
	}

	.model-kind.llm {
		border-color: color-mix(in srgb, var(--catalog-cyan) 42%, transparent);
		color: var(--catalog-cyan);
	}

	.card-description {
		display: -webkit-box;
		min-height: 2.8rem;
		margin: 0.75rem 1rem;
		overflow: hidden;
		color: var(--of-text-muted);
		font-size: 0.8rem;
		line-height: 1.55;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.endpoint-section {
		margin: 0 0.75rem 0.75rem;
		padding: 0.7rem;
		border: 1px solid var(--of-border-subtle);
		border-radius: 0.72rem;
		background: color-mix(in srgb, var(--of-bg-base) 55%, transparent);
	}

	.section-label {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.45rem;
		color: var(--of-text-muted);
		font: 600 0.67rem/1 var(--sl-font-mono);
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.section-label em {
		font-style: normal;
	}

	.endpoint-list {
		display: grid;
		gap: 0.35rem;
	}

	.endpoint-row {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		gap: 0.55rem;
		align-items: center;
		min-width: 0;
		padding: 0.48rem 0.5rem;
		border-radius: 0.48rem;
		background: color-mix(in srgb, var(--of-text-primary) 3%, transparent);
	}

	.protocol-dot {
		width: 0.38rem;
		height: 0.38rem;
		border-radius: 50%;
		background: var(--catalog-cyan);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--catalog-cyan) 11%, transparent);
	}

	.protocol-anthropic {
		background: var(--of-signal-warn);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--of-signal-warn) 11%, transparent);
	}

	.protocol-gemini {
		background: var(--of-accent-alt);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--of-accent-alt) 11%, transparent);
	}

	.endpoint-row div {
		min-width: 0;
	}

	.endpoint-row small,
	.endpoint-row code {
		display: block;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.endpoint-row small {
		margin-bottom: 0.16rem;
		color: var(--of-text-muted);
		font-size: 0.64rem;
		text-transform: capitalize;
	}

	.endpoint-row code {
		padding: 0;
		color: var(--of-text-secondary);
		background: none;
		font-size: 0.7rem;
	}

	.endpoint-row button,
	.model-id-row button {
		display: grid;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		padding: 0;
		border: 1px solid transparent;
		border-radius: 0.4rem;
		color: var(--of-text-muted);
		background: transparent;
		cursor: pointer;
	}

	.endpoint-row button:hover,
	.model-id-row button:hover,
	.endpoint-row button.copied,
	.model-id-row button.copied {
		border-color: var(--of-border-default);
		color: var(--catalog-cyan);
		background: var(--of-surface-card);
	}

	.endpoint-row svg,
	.model-id-row svg {
		width: 0.92rem;
		height: 0.92rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
	}

	.card-actions {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1rem;
		padding: 0.75rem 1rem;
		border-top: 1px solid var(--of-border-subtle);
		margin-top: auto;
	}

	.card-action-links a,
	.model-card .card-actions > a,
	.card-actions summary {
		color: var(--of-text-muted);
		font-size: 0.72rem;
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
		list-style: none;
	}

	.card-actions summary::-webkit-details-marker {
		display: none;
	}

	.card-action-links a:hover,
	.model-card .card-actions > a:hover,
	.card-actions summary:hover {
		color: var(--catalog-cyan);
	}

	.card-action-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		justify-content: flex-end;
		margin-inline-start: auto;
	}

	.card-action-links .provider-platform-link {
		color: var(--catalog-cyan);
	}

	.model-id-row {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 0.38rem;
	}

