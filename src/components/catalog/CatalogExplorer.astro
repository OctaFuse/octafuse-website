type CatalogKind = 'providers' | 'models';
type Locale = 'zh' | 'en';
type ProviderItem = (typeof providerCatalog.items)[number];
type ModelItem = (typeof modelCatalog.items)[number];
type CatalogPriceTier = {
	upto?: number | null;
	input_price?: number | null;
	output_price?: number | null;
	cache_read_price?: number | null;
	cache_write_price?: number | null;
	image_input_price?: number | null;
	image_input_cache_price?: number | null;
	image_output_price?: number | null;
};
type CatalogPriceProfile = {
	image_billing_mode?: 'per_image' | 'token';
	image?: {
		default?: number | null;
	};
	tiers?: CatalogPriceTier[];
};

interface Props {
	kind: CatalogKind;
	locale: Locale;
}

const { kind, locale } = Astro.props;
const isProviders = kind === 'providers';
const catalog = isProviders ? providerCatalog : modelCatalog;
const items = catalog.items;
const repo = `https://github.com/${catalog.source.repo}`;
const editRoot = isProviders
	? `${repo}/edit/main/${providerCatalog.source_path}`
	: `${repo}/tree/main/${modelCatalog.source_path}`;

