---
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';

const isEnglish = Astro.url.pathname.startsWith('/en/');
const isUpdate = Astro.locals.starlightRoute.entry.data.publishDate !== undefined;
const localePrefix = isEnglish ? '/en' : '/zh';
const year = new Date().getFullYear();
const groups = isEnglish
	? [
			{
				title: 'Explore',
				links: [
					{ label: 'Updates', href: `${localePrefix}/updates/` },
					{ label: 'Documentation', href: `${localePrefix}/docs/` },
					{ label: 'Quick start', href: `${localePrefix}/docs/quick-start/` },
					{ label: 'Cloudflare deployment', href: `${localePrefix}/docs/deploy/cloudflare/` },
				],
			},
			{
				title: 'Catalog',
				links: [
					{ label: 'Providers', href: `${localePrefix}/catalog/providers/` },
					{ label: 'Models', href: `${localePrefix}/catalog/models/` },
				],
			},
			{
				title: 'Community',
				links: [
					{ label: 'GitHub', href: 'https://github.com/OctaFuse/octafuse-gateway' },
					{
						label: 'Contributing',
						href: 'https://github.com/OctaFuse/octafuse-gateway/blob/main/CONTRIBUTING.md',
					},
					{
						label: 'AGPL-3.0 license',
						href: 'https://github.com/OctaFuse/octafuse-gateway/blob/main/LICENSE',
					},
				],
			},
		]
	: [
			{
				title: '探索',
				links: [
					{ label: '动态', href: `${localePrefix}/updates/` },
					{ label: '产品文档', href: `${localePrefix}/docs/` },
					{ label: '快速开始', href: `${localePrefix}/docs/quick-start/` },
					{ label: 'Cloudflare 部署', href: `${localePrefix}/docs/deploy/cloudflare/` },
				],
			},
			{
				title: 'Catalog',
				links: [
					{ label: 'Provider Catalog', href: `${localePrefix}/catalog/providers/` },
					{ label: 'Model Catalog', href: `${localePrefix}/catalog/models/` },
				],
			},
			{
				title: '社区',
				links: [
					{ label: 'GitHub', href: 'https://github.com/OctaFuse/octafuse-gateway' },
					{
						label: '贡献指南',
						href: 'https://github.com/OctaFuse/octafuse-gateway/blob/main/CONTRIBUTING.md',
					},
					{
						label: 'AGPL-3.0 许可证',
						href: 'https://github.com/OctaFuse/octafuse-gateway/blob/main/LICENSE',
					},
				],
			},
		];
---

<footer class="site-footer">
	{isUpdate && <Pagination />}
	<div class="page-meta sl-flex">
		<EditLink />
		<LastUpdated />
	</div>
	{!isUpdate && <Pagination />}

	<div class="footer-panel">
		<div class="footer-brand">
			<a class="footer-logo" href={`${localePrefix}/`} aria-label="OctaFuse home">
				<img src="/favicon.svg" width="34" height="34" alt="" />
				<strong>OctaFuse</strong>
			</a>
			<p>
				{
					isEnglish
						? 'A self-hostable AI capability gateway and operations control plane.'
						: '可自托管的 AI 能力网关与运营控制面。'
				}
			</p>
			<span>{isEnglish ? 'Open source · Built for control' : '开源 · 自托管 · 为可控而生'}</span>
		</div>

		<div class="footer-links">
			{
				groups.map((group) => (
					<section>
						<h2>{group.title}</h2>
						<ul>
							{group.links.map((link) => (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</div>
	</div>

	<div class="footer-bottom">
		<span>© {year} OctaFuse</span>
		<span>{isEnglish ? 'Gateway clarity, from upstream to every call.' : '从上游能力到每一次调用，保持清晰。'}</span>
	</div>
</footer>

<style>
	@layer starlight.core {
		.site-footer {
			display: flex;
			flex-direction: column;
			gap: 1.5rem;
			margin-top: clamp(4rem, 8vw, 7rem);
		}

		.page-meta {
			gap: 0.75rem 3rem;
			justify-content: space-between;
			flex-wrap: wrap;
			font-size: var(--sl-text-sm);
			color: var(--sl-color-gray-3);
		}

		.page-meta > :global(p:only-child) {
			margin-inline-start: auto;
		}

		.footer-panel {
			display: grid;
			grid-template-columns: minmax(15rem, 1.05fr) minmax(0, 1.6fr);
			gap: clamp(2rem, 6vw, 5rem);
			padding: clamp(1.5rem, 4vw, 2.5rem);
			border: 1px solid var(--of-card-border);
			border-radius: 0.65rem;
			background:
				linear-gradient(120deg, hsl(184 100% 55% / 0.08), transparent 38%),
				var(--of-surface-card);
			box-shadow: inset 0 1px 0 hsl(0 0% 100% / 0.05), var(--sl-shadow-sm);
		}

		.footer-brand {
			align-self: start;
		}

		.footer-logo {
			display: inline-flex;
			align-items: center;
			gap: 0.7rem;
			color: var(--of-text-primary);
			font-size: 1.15rem;
			text-decoration: none;
		}

		.footer-logo img {
			filter: drop-shadow(0 0 0.65rem var(--of-hero-glow));
		}

		.footer-brand p {
			max-width: 24rem;
			margin: 1rem 0 0.65rem;
			color: var(--of-text-secondary);
			line-height: 1.65;
		}

		.footer-brand span {
			color: var(--of-text-muted);
			font-family: var(--sl-font-mono);
			font-size: var(--sl-text-xs);
			letter-spacing: 0.04em;
		}

		.footer-links {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.5rem;
		}

		.footer-links h2 {
			margin: 0 0 0.85rem;
			color: var(--of-text-primary);
			font-family: var(--sl-font-mono);
			font-size: 0.72rem;
			letter-spacing: 0.1em;
			text-transform: uppercase;
		}

		.footer-links ul {
			margin: 0;
			padding: 0;
			list-style: none;
		}

		.footer-links li + li {
			margin-top: 0.55rem;
		}

		.footer-links a {
			color: var(--of-text-muted);
			font-size: var(--sl-text-sm);
			text-decoration: none;
			transition: color 0.15s ease;
		}

		.footer-links a:hover {
			color: var(--of-accent-strong);
		}

		.footer-bottom {
			display: flex;
			justify-content: space-between;
			gap: 1rem;
			padding: 0 0.25rem 2rem;
			color: var(--of-text-muted);
			font-size: var(--sl-text-xs);
		}

		@media (max-width: 48rem) {
			.footer-panel {
				grid-template-columns: 1fr;
			}

			.footer-links {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}

			.footer-bottom {
				flex-direction: column;
			}
		}

		@media (max-width: 30rem) {
			.footer-links {
				grid-template-columns: 1fr;
			}
		}
	}
</style>
