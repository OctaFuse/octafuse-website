---
const { data } = Astro.locals.starlightRoute.entry;
const publishDate = data.publishDate;
const isEnglish = Astro.locals.starlightRoute.lang.startsWith('en');
const dateTime = publishDate?.toISOString().slice(0, 10);
const formattedDate = publishDate
	? new Intl.DateTimeFormat(isEnglish ? 'en' : 'zh-CN', {
			dateStyle: 'long',
			timeZone: 'UTC',
		}).format(publishDate)
	: undefined;
---

<h1 id="_top" class:list={{ 'update-page-title': publishDate }}>{data.title}</h1>
{
	publishDate && formattedDate && (
		<p class="publish-date">
			<span>{isEnglish ? 'Published' : '发布于'}</span>
			<time datetime={dateTime}>{formattedDate}</time>
		</p>
	)
}

<style>
	@layer starlight.core {
		h1 {
			margin-top: 1rem;
			color: var(--sl-color-white);
			font-size: var(--sl-text-h1);
			font-weight: 600;
			line-height: var(--sl-line-height-headings);
		}

		.publish-date {
			display: flex;
			align-items: center;
			gap: 0.45rem;
			margin: 0.8rem 0 0;
			color: var(--of-text-muted);
			font-family: var(--sl-font-mono);
			font-size: var(--sl-text-xs);
			letter-spacing: 0.025em;
		}

		.publish-date span::after {
			content: '·';
			margin-inline-start: 0.45rem;
			color: var(--of-accent);
		}
	}
</style>
